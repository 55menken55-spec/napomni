<?xml version="1.0" encoding="utf-8"?>
<!-- Копирование данных (облако / перенос на другое устройство) отключено.
     Резервная копия делается только вручную через экспорт в файл (ТЗ, FR-10). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
